+  // ENABLE_C_INTERPRETER and generates the stackmap at bci(). jit_frame_enter parked
+  // g_jpc at the method base (bci=0) and compiled code never advances it, so the GC
+  // would use the ENTRY stackmap (only argument objects, an empty expression stack)
+  // and MISS any object created/derived that is live on the expression stack or in a
+  // local across this GC point -> the object is not a root -> moved/collected -> the
+  // compiled method reloads a stale pointer -> spurious NPE/crash (seen booting a real
+  // MIDlet). Fix: before every operation that can GC, set g_jpc to the CURRENT
+  // bytecode's bci so the GC uses the correct stackmap. invoke_java_method saves this
+  // as the caller frame's bcp_store, so a GC deeper in the callee also scans this frame
+  // correctly. GET_FRAME(method) is the compiled caller's method (g_jfp points at its
+  // frame when the helper runs) and is GC-relocated, so it stays valid across the GC.
+  static void jit_set_safepoint_bcp(int bci) {
+    g_jpc = GET_FRAME(method) + Method::base_offset() + bci;
+    { static bool _once = false; if (!_once) { _once = true;
+        tty->print_cr("[PS2ME-JIT] Fase 5: GC safepoint bcp ACTIVE (safepoints build)"); } }
+  }
