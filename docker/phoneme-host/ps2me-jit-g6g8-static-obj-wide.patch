@@ -3293,6 +3299,28 @@
           l = a_bci + (2 + 2 * npairs) * 4 - bci;
           break;
         }
+        // Group 8 (wide, 0xc4): the wide prefix widens the following local-access opcode's
+        // index to 2 bytes (wide iload/istore/aload/astore/lload/lstore) or the iinc index AND
+        // constant to 2 bytes each (wide iinc). Method::iterate already dispatches wide to the
+        // SAME load_local/store_local/increment_local_int closures, and the backend addresses a
+        // local as g_jlocals - index*4 regardless of index width, so this is WHITELIST-ONLY.
+        // Accept only sub-opcodes the r5900 backend covers (int/object/long local access + iinc);
+        // reject wide fload/dload/fstore/dstore (no FP backend) and wide ret (jsr/ret unsupported).
+        // Variable length via wide_length_for = 4, or 6 for wide iinc.
+        case Bytecodes::_wide: {
+          const jubyte sub = m().ubyte_at(bci + 1);
+          switch (sub) {
+            case Bytecodes::_iload:  case Bytecodes::_istore:
+            case Bytecodes::_aload:  case Bytecodes::_astore:
+            case Bytecodes::_lload:  case Bytecodes::_lstore:
+            case Bytecodes::_iinc:
+              break;                                      // covered sub-opcode
+            default:
+              return false;                               // wide float/double/ret -> interpret
+          }
+          l = Bytecodes::wide_length_for(&m(), bci, Bytecodes::_wide);
+          break;
+        }
         default:
           return false;                                 // not covered by Marco 3.2a
       }
