--- a/cldc/src/vm/share/compiler/Value.cpp
+++ b/cldc/src/vm/share/compiler/Value.cpp
@@ -174,10 +174,21 @@
             // in the TEXT block. At this point we don't know the block type of
             // the referenced object, so for now we disable setting immediate
             // for cross generator.
+#if defined(MIPS)
+            // PS2ME r5900 (Group 6 static objects): the backend has NO oop-relocation
+            // stream (Compiler::oops_do is a no-op on MIPS), so a moveable object
+            // referent cannot be embedded as an immediate (CodeGenerator::move only
+            // materializes a class base via class_list or a String via cpool[idx]).
+            // Leave the Value NOT-present so BytecodeCompileClosure::get_static falls
+            // back to the GC-safe load-path (resolve the holder class via class_list,
+            // then load the static slot at runtime).
+            (void)object;
+#else
             if (!USE_AOT_COMPILATION || !GenerateROMImage) {
-              object = ic->obj_field(offset); 
+              object = ic->obj_field(offset);
               set_obj(&object);
             }
+#endif
             break;
 #if ENABLE_FLOAT
           case T_FLOAT   : set_float(ic->float_field(offset));   break;
--- a/cldc/src/vm/cpu/c/Interpreter_c.cpp
