+  // Grupo 4 (long): the two-word return helper + the long primitives the r5900
+  // backend does not do 64-bit-native in this build (this port has no jvm_l*: those
+  // live only in the ARM/i386 InterpreterRuntime, and GPSkeleton's are stubs with
+  // ENABLE_INTERPRETER_GENERATOR=false). These are plain C -- the EE gcc emits
+  // correct `long long` code, byte-for-byte the interpreter's own lmul/lshl/lshr/
+  // lushr/lcmp (shift count masked to 0x3f per JVMS).
+  //
+  // ABI (CRITICAL): the ps2dev EE toolchain is n32/n64, NOT o32 -- a jlong lives in a
+  // SINGLE 64-bit register (a0, a1, ...; return in v0), never in a 32-bit register
+  // PAIR. The r5900 JIT keeps longs as two 32-bit registers (lo/hi), so the helpers
+  // take the two words as SEPARATE jint arguments (each arriving in its own 64-bit
+  // arg register, low word only) and reassemble via jlong_accessor. Returned jlongs
+  // still come back 64-bit-packed in v0, so the backend splits v0 into lo/hi
+  // (sll/dsra32). MSW_FIRST_FOR_LONG=0 => words[0]=LSW, words[1]=MSW.
+  extern "C" void jit_return_long(jint lo, jint hi) {
+    jlong_accessor acc; acc.words[0] = lo; acc.words[1] = hi;
+    LONG_PUSH(acc.long_value);
+    return_internal(T_LONG);
+  }
+  extern "C" jlong jit_lmul (jint alo, jint ahi, jint blo, jint bhi) {
+    jlong_accessor a, b; a.words[0]=alo; a.words[1]=ahi; b.words[0]=blo; b.words[1]=bhi;
+    return a.long_value * b.long_value;
+  }
+  extern "C" jlong jit_lshl (jint alo, jint ahi, jint s) {
+    jlong_accessor a; a.words[0]=alo; a.words[1]=ahi;
+    return a.long_value << (s & 0x3f);
+  }
+  extern "C" jlong jit_lshr (jint alo, jint ahi, jint s) {   // arithmetic
+    jlong_accessor a; a.words[0]=alo; a.words[1]=ahi;
+    return a.long_value >> (s & 0x3f);
+  }
+  extern "C" jlong jit_lushr(jint alo, jint ahi, jint s) {   // logical
+    jlong_accessor a; a.words[0]=alo; a.words[1]=ahi;
+    return (jlong)((julong)a.long_value >> (s & 0x3f));
+  }
+  extern "C" jint  jit_lcmp (jint alo, jint ahi, jint blo, jint bhi) {
+    jlong_accessor a, b; a.words[0]=alo; a.words[1]=ahi; b.words[0]=blo; b.words[1]=bhi;
+    return a.long_value < b.long_value ? -1 : a.long_value == b.long_value ? 0 : 1;
+  }
