+  // jit_timer_tick(): backward-branch (loop) timer check for compiled methods
+  // (Marco 3.2b). Replicates the interpreter's own check_timer_tick(): when a
+  // pending real-time tick is set, run the VM's timer_tick (which may switch
+  // threads / trigger GC). The compiled method's check_timer_tick emission
+  // flushes the VirtualStackFrame to memory (g_jlocals/g_jsp) before calling
+  // this, so no Java value lives in a caller-saved register across the call and
+  // the Java frame is consistent for GC/thread-switch. When no tick is pending
+  // (the common case) this is a single memory load + return.
+  extern "C" void jit_timer_tick() {
+    check_timer_tick();
+  }
+
 #if defined(PS2ME_JIT_FASE2)
   // Fase 2 trigger. Arms trivial empty-void methods (single `return` bytecode,
   // non-native, non-synchronized) for compilation by pointing their execution
@@ -2436,24 +2448,23 @@
         case Bytecodes::_iload:  case Bytecodes::_istore:
         case Bytecodes::_bipush:
           l = 2; break;
+        case Bytecodes::_iinc:                          // Marco 3.2b: for-loops
+          l = 3; break;
         case Bytecodes::_sipush:
           l = 3; break;
-        // Marco 3.2a: forward conditional/unconditional branches. Backward
-        // branches (loops) need check_timer_tick/call_vm -> Marco 3.2b, so any
