+#if defined(PS2ME_JIT_FASE3)
+  // Fase 3 (Marco 3.1) trigger. Arms straight-line integer methods whose every
+  // bytecode is implemented by the incremental CodeGenerator (local loads + int
+  // add/sub/mul/and/or/xor, register and immediate forms). Any other bytecode
+  // (branch, invoke, field/array, long/float, ...) fails the whitelist and the
+  // method is left interpreted -- so an armed method is always 100% compilable,
+  // never a SHOULD_NOT_REACH_HERE bail-out. The whitelist is the safety gate;
+  // no class-name check is needed (the JitTest harness leaves are the methods
+  // that match, and its main()/check() carry invokes and stay out).
+  static bool jit_fase3_whitelisted(address method) {
+    Method::Raw m = (ReturnOop)method;
+    const int len = m().code_size();
+    if (len < 1 || len > 60) return false;              // keep bring-up small
+    int bci = 0;
+    while (bci < len) {
+      const jubyte bc = m().ubyte_at(bci);
+      int l;
+      switch (bc) {
+        case Bytecodes::_iconst_m1: case Bytecodes::_iconst_0:
+        case Bytecodes::_iconst_1:  case Bytecodes::_iconst_2:
+        case Bytecodes::_iconst_3:  case Bytecodes::_iconst_4:
+        case Bytecodes::_iconst_5:
+        case Bytecodes::_iload_0:   case Bytecodes::_iload_1:
+        case Bytecodes::_iload_2:   case Bytecodes::_iload_3:
+        case Bytecodes::_istore_0:  case Bytecodes::_istore_1:
+        case Bytecodes::_istore_2:  case Bytecodes::_istore_3:
+        case Bytecodes::_iadd: case Bytecodes::_isub: case Bytecodes::_imul:
+        case Bytecodes::_iand: case Bytecodes::_ior:  case Bytecodes::_ixor:
+        case Bytecodes::_ireturn:
+          l = 1; break;
+        case Bytecodes::_iload:  case Bytecodes::_istore:
+        case Bytecodes::_bipush:
+          l = 2; break;
+        case Bytecodes::_sipush:
+          l = 3; break;
+        // Marco 3.2a: forward conditional/unconditional branches. Backward
+        // branches (loops) need check_timer_tick/call_vm -> Marco 3.2b, so any
+        // negative branch offset disqualifies the method (stays interpreted).
+        case Bytecodes::_ifeq: case Bytecodes::_ifne:
+        case Bytecodes::_iflt: case Bytecodes::_ifge:
+        case Bytecodes::_ifgt: case Bytecodes::_ifle:
+        case Bytecodes::_if_icmpeq: case Bytecodes::_if_icmpne:
+        case Bytecodes::_if_icmplt: case Bytecodes::_if_icmpge:
+        case Bytecodes::_if_icmpgt: case Bytecodes::_if_icmple:
+        case Bytecodes::_goto: {
+          const int hi  = m().ubyte_at(bci + 1);
+          const int lo  = m().ubyte_at(bci + 2);
+          const int off = (int)(jshort)((hi << 8) | lo);
+          if (off < 0) return false;                    // backward -> not yet
+          l = 3; break;
+        }
+        default:
+          return false;                                 // not covered by Marco 3.2a
+      }
+      bci += l;
+    }
+    return true;
+  }
+
+  enum { JIT_FASE3_MAX_ARMED = 32 };
+  static int jit_fase3_armed_count = 0;
+  void jit_fase3_arm(address method) {
+    if (Universe::before_main()) return;
+    if (jit_fase3_armed_count >= JIT_FASE3_MAX_ARMED) return;
+    if (get_access_flags(method) & (JVM_ACC_NATIVE | JVM_ACC_SYNCHRONIZED)) return;
+    if (!jit_fase3_whitelisted(method)) return;
+    Method::Raw m = (ReturnOop)method;
+    if (m().has_compiled_code()) return;                    // already compiled
+    if (m().execution_entry() == (address)shared_invoke_compiler) return; // armed
+    jit_fase3_armed_count++;
+    m().set_execution_entry((address)shared_invoke_compiler);
+    // Log the bytecodes (they identify each leaf: iload_0/iload_1/<op>/ireturn)
+    // plus the name; print_name_on_tty may be empty in some builds, the byte
+    // dump never is.
+    tty->print("[PS2ME-JIT] Fase 3: armed #%d ", jit_fase3_armed_count);
+    m().print_name_on_tty();
+    tty->print(" bc=[");
+    { const int len = m().code_size();
+      for (int i = 0; i < len; i++) tty->print("%02x ", m().ubyte_at(i)); }
+    tty->print_cr("]");
+  }
+#endif // PS2ME_JIT_FASE3
 #endif // ENABLE_COMPILER
 
