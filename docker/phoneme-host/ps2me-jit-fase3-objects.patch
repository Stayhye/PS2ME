+  // Marco 3.8: object allocation + type checks from compiled code. Each takes a
+  // class_id -- the shared closure resolved the class at COMPILE TIME (get_klass_or_null)
+  // and the backend emits it as an immediate, so no moveable oop is baked into the
+  // native code (GC-safe); the helper re-derives the class with get_class_by_id, the
+  // same wrapper the invoke helpers use. blueprint(object) is two indirections
+  // (object -> java near -> class), matching jit_invoke_interface's receiver walk.
+
+  // jit_new(): allocate a fixed-size instance. The class is guaranteed resolved AND
+  // initialized at compile time (BCC new_object took uncommon_trap otherwise; and
+  // ENABLE_ISOLATES=0 so there is no per-task cib barrier), so this is a plain
+  // allocation with no class-init step. _newobject runs through the call_vm mechanism
+  // (interpreter_call_vm_1): GC-safe, and on OutOfMemoryError it returns true after
+  // find_exception_frame has repositioned g_jfp -> the compiled caller's fp-check
+  // ejects and the (unused) return value does not matter. On success the fresh oop is
+  // in the thread's obj_value slot (shared_call_vm_internal stored it there).
+  extern "C" address jit_new(int class_id) {
+    address klass = get_class_by_id((jushort)class_id);
+    if (interpreter_call_vm_1((address)&_newobject, T_OBJECT, (jint)klass)) {
+      return NULL;                       // OOM: g_jfp repositioned, caller fp-check ejects
+    }
+    return (address)GET_THREAD_INT(obj_value);
+  }
+
+  // jit_instanceof(): 0/1 subtype test. The backend flushed the object to the top of
+  // g_jsp; read it with OBJ_PEEK(0). A null object is never an instance. Otherwise take
+  // its blueprint and run the pure subtype check (_instanceof does object_class
+  // is_subtype_of test_class; no allocation, no throw), so it can be called directly.
+  extern "C" jint jit_instanceof(int class_id) {
+    address object = OBJ_PEEK(0);
+    if (object == NULL) {
+      return 0;
+    }
+    address obj_class  = *(address*)(*(address*)object);   // object -> near -> class
+    address test_class = get_class_by_id((jushort)class_id);
+    return _instanceof(NATIVE_ARG, (OopDesc*)obj_class, (OopDesc*)test_class);
+  }
+
+  // jit_checkcast(): like jit_instanceof but throws ClassCastException on a failed cast
+  // (a null object always passes). The throw goes through the interp's own path
+  // (interpreter_throw_ClassCastException -> call_vm), which runs find_exception_frame
+  // and repositions g_jfp so the compiled caller's option-B fp-check ejects.
+  extern "C" void jit_checkcast(int class_id) {
+    address object = OBJ_PEEK(0);
+    if (object == NULL) {
+      return;                            // null passes checkcast
+    }
+    address obj_class  = *(address*)(*(address*)object);
+    address test_class = get_class_by_id((jushort)class_id);
+    if (_instanceof(NATIVE_ARG, (OopDesc*)obj_class, (OopDesc*)test_class)) {
+      return;                            // ok: object is a subtype of the target class
+    }
+    interpreter_throw_ClassCastException();
+  }
