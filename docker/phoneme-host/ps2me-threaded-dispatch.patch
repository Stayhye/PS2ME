+/* ps2me-threaded (FASE 3): tail-threaded dispatch. Each bytecode handler ends by
+   tail-calling the next handler; with gcc -O2 sibling-call optimization this becomes a
+   direct jump, eliminating the return-to-loop AND giving each bytecode its OWN indirect
+   dispatch site (far better branch prediction than the single shared dispatch site in the
+   for(;;) trampoline). The trampoline loop in Interpret() stays as the landing pad for
+   handlers that early-`return` (exceptions). Off unless -DPS2ME_THREADED, so production
+   builds are unchanged. WARNING: correctness depends on the tail call being sibcall-
+   optimized in EVERY handler (else the stack grows per bytecode) -- validated on the host
+   by a long run (no stack overflow) + identical InterpBench checksums before shipping. */
+#ifdef PS2ME_THREADED
+/* musttail (gcc 15+) FORCES the sibling-call: every handler ends in a guaranteed `jmp`
+   to the next, or the build fails naming the handler that cannot tail-call -- so the stack
+   never grows silently (a plain tail call left ~half the handlers as `call`, overflowing
+   the stack after ~100M bytecodes). */
+#define BYTECODE_IMPL_END \
+  PS2ME_BC_TICK(); \
+  __attribute__((musttail)) return interpreter_dispatch_table[*g_jpc](); \
+  }
+/* Some handlers delegate to another handler as their last act (fast_init_new -> new,
+   aload_0_fast_igetfield_1 -> fast_igetfield_1, ...). Under threading the callee ends in a
+   musttail dispatch and never returns, so a plain `bc_impl_x(); END` would recurse (the
+   caller's frame is never freed -> stack overflow). Chain into it as a tail call instead. */
+#define BYTECODE_IMPL_CHAIN(target) __attribute__((musttail)) return target(); }
+/* Same idea for handlers that dispatch a computed table slot as their last act
+   (wide -> the wide variant of the next opcode). */
+#define BYTECODE_IMPL_CHAIN_IDX(idx) \
+  __attribute__((musttail)) return interpreter_dispatch_table[idx](); }
+#else
 #define BYTECODE_IMPL_END }
+#define BYTECODE_IMPL_CHAIN(target) target(); }
+#define BYTECODE_IMPL_CHAIN_IDX(idx) interpreter_dispatch_table[idx](); }
+#endif
 
   START_BYTECODES
 
