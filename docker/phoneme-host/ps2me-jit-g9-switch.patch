--- a/cldc/src/vm/cpu/c/Interpreter_c.cpp
+++ b/cldc/src/vm/cpu/c/Interpreter_c.cpp
@@ -3255,6 +3255,39 @@
           l = 1; break;
         case Bytecodes::_newarray:
           l = 2; break;
+        // Group 9 (switch): tableswitch/lookupswitch lower to a COMPARE-AND-BRANCH
+        // chain in the backend (CodeGenerator_mips.cpp table_switch/lookup_switch) --
+        // no inline jump table, so no address relocation (the r5900 backend has none).
+        // Variable length: the operand table is 4-byte aligned after the opcode, so
+        // a_bci = align4(bci+1); tableswitch = default(4)+low(4)+high(4)+(high-low+1)*4,
+        // lookupswitch = default(4)+npairs(4)+npairs*8 (matches Bytecodes::wide_length_for
+        // and the interp's tableswitch/lookupswitch handlers). Require every case offset
+        // to be FORWARD: the backend bails (permanently) on a backward offset (a switch
+        // used as a loop back-edge it does not model), so reject here to avoid arming a
+        // method that would only arm-then-bail. get_java_switch_int reads a native int
+        // from the (romized) aligned table, exactly like CodeGenerator::table_switch.
+        case Bytecodes::_tableswitch: {
+          const int a_bci = (bci + 1 + 3) & ~3;
+          const int lo = m().get_java_switch_int(a_bci + 4);
+          const int hi = m().get_java_switch_int(a_bci + 8);
+          if (hi < lo) return false;
+          const int npairs = hi - lo + 1;
+          for (int i = 0; i < npairs; i++) {
+            if (m().get_java_switch_int(a_bci + 12 + 4 * i) <= 0) return false;
+          }
+          l = a_bci + (3 + npairs) * 4 - bci;
+          break;
+        }
+        case Bytecodes::_lookupswitch: {
+          const int a_bci = (bci + 1 + 3) & ~3;
+          const int npairs = m().get_java_switch_int(a_bci + 4);
+          if (npairs < 0) return false;
+          for (int i = 0; i < npairs; i++) {
+            if (m().get_java_switch_int(a_bci + 8 + 8 * i + 4) <= 0) return false;
+          }
+          l = a_bci + (2 + 2 * npairs) * 4 - bci;
+          break;
+        }
         default:
           return false;                                 // not covered by Marco 3.2a
       }
