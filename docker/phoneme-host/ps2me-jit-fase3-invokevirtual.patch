+  // jit_invoke_virtual(): the REAL virtual call from compiled code (Marco 3.6c-vtable
+  // 2/3). Mirrors fast_invoke_internal's !has_fixed_target_method branch: the callee
+  // is dispatched DYNAMICALLY on the RECEIVER's vtable. Read vindex+klazz_id from the
+  // cpool, resolve the cpool-class method (get_method_from_ci) only to learn its
+  // parameter count, locate the receiver on the Java stack (OBJ_PEEK(num_params-1)),
+  // take its near/prototype (*(address*)receiver) and index the RECEIVER's vtable
+  // (get_method_from_vtable) -- so an overriding subclass method is chosen at runtime.
+  // The receiver null-check already ran in the backend (CodeGenerator::invoke_virtual)
+  // before this call, so the receiver is non-null here (we skip the interp's
+  // NULL_CHECK). After resolution the machinery is identical to jit_invoke_static:
+  // invoke_java_method + the nested dispatch loop bounded by the caller frame, then
+  // the caller's post-invoke option-B fp-check ejects if the callee unwound past it.
+  extern "C" void jit_invoke_virtual(int cpool_index, int invoker_size) {
+    address caller_fp = g_jfp;
+    address cpool = GET_FRAME(cpool);
+    jushort vindex   = first_ushort_from_cpool(cpool, (jushort)cpool_index);
+    jushort klazz_id = second_ushort_from_cpool(cpool, (jushort)cpool_index);
+    address klazz = get_class_by_id(klazz_id);
+    address ci = *(address*)(klazz + JavaClass::class_info_offset());
+    address method = get_method_from_ci(ci, vindex);
+    jushort num_params = get_num_params(method);
+    address receiver = OBJ_PEEK(num_params - 1);   // non-null (backend null-checked)
+    receiver = *(address*)receiver;                // java near (receiver prototype)
+    method = get_method_from_vtable(receiver, vindex);
+
+    invoke_java_method(method, invoker_size);
+
+    // Drive an interpreted callee to completion (no-op for a compiled callee).
+    while ((address)g_jfp < caller_fp) {
+      interpreter_dispatch_table[*g_jpc]();
+    }
+  }
+
