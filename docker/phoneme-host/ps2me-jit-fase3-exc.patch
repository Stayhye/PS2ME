+  // jit_throw_null_pointer() / jit_throw_array_index(): raise a runtime exception
+  // from compiled code (Marco 3.4a). These are thin wrappers over the interp's
+  // OWN throw path: interpreter_throw_* allocates the exception and, via
+  // interpreter_call_vm's T_ILLEGAL dispatch, runs find_exception_frame over the
+  // g_jfp chain (the compiled leaf frame jit_frame_enter built, then its interp
+  // caller) and repositions g_jfp/g_jsp/g_jpc/g_jlocals to the handler frame --
+  // exactly as an interpreted array-access bytecode does. The compiled method
+  // then runs only its native-stack epilogue (jr ra, emitted by
+  // mips_emit_runtime_throw), NOT jit_return: the Java frame is already unwound.
+  // Control returns by natural C returns to the flat interpreter dispatch loop,
+  // which resumes at the handler bcp. When there is no handler, the interp path
+  // longjmps to thread-exit, which also discards this nested native frame.
+  extern "C" void jit_throw_null_pointer() {
+    interpreter_throw_NullPointerException();
+  }
+  extern "C" void jit_throw_array_index() {
+    interpreter_throw_ArrayIndexOutOfBoundsException();
+  }
