ps2me-frame-profile (PASSO 0b): time the native gxj draw primitives BY CATEGORY so the in-game
frame profiler can split (A) interpret from (B) native draw and break B into fill / blit /
other(line,tri,copyArea) / pixel(drawRGB,getRGB). Each instrumented function declares a scoped
__attribute__((cleanup)) timer (robust to early returns) calling our layer's ps2me_prof_now()/
ps2me_prof_draw_add(start,cat), resolved at the final --start-group link. Compiled in ONLY under
-DPS2ME_PROFILE_FRAME (ps2_mips_gcc.gmk hook) -> production byte-identical. Applied with
--ignore-whitespace after LF-normalizing (tree may be CRLF).

--- a/midp/src/lowlevelui/graphics/gx_putpixel/native/gxj_graphics.c
+++ b/midp/src/lowlevelui/graphics/gx_putpixel/native/gxj_graphics.c
@@ -96,10 +96,22 @@
 /**
  * Draw triangle
  */
+/* ps2me-frame-profile (PASSO 0b): native-draw timing for the A/B frame split, by category. */
+#ifdef PS2ME_PROFILE_FRAME
+extern long long ps2me_prof_now(void);
+extern void ps2me_prof_draw_add(long long startTick, int cat);
+typedef struct { long long t; int cat; } ps2me_prof_scope_t;
+static inline void ps2me_prof_draw_cleanup(ps2me_prof_scope_t *s) { ps2me_prof_draw_add(s->t, s->cat); }
+#define PS2ME_PROF_DRAW_SCOPE(CAT) \
+  ps2me_prof_scope_t __attribute__((cleanup(ps2me_prof_draw_cleanup))) _ps2me_pdt = { ps2me_prof_now(), (CAT) }
+#else
+#define PS2ME_PROF_DRAW_SCOPE(CAT) ((void)0)
+#endif
