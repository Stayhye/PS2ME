+        // Marco 3.6c-vtable: _fast_invokespecial (super.m() non-init + private
+        // methods -- invokespecial-to-<init> quickens to _fast_invokevirtual_final
+        // above). It resolves via the cpool class's vtable (vindex+klazz_id ->
+        // get_class_by_id -> class_info -> get_method_from_ci), NOT a direct method
+        // pointer, so it cannot be scanned with get_from_cpool. But the shared
+        // fast_invoke_special closure ALWAYS lowers through __ invoke -- a real call,
+        // it NEVER inlines (unlike the static/final do_direct_invoke path) -- so the
+        // callee runs via the normal VM path (interpreted, or compiled if separately
+        // armed) and its bytecodes never pass through our backend: coverage is NOT
+        // required. Accept at the top level; the backend (CodeGenerator::invoke)
+        // routes it to jit_invoke_special (dynamic-vtable resolution).
+        case Bytecodes::_fast_invokespecial:
+          if (!allow_invoke) return false;
+          l = 3; break;
         default:
           return false;                                 // not covered by Marco 3.2a
